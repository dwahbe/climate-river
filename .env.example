# Database
# Primary database connection string (one of these is required)
DATABASE_URL=postgresql://user:password@host:port/database

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# API Security
# Token to protect cron and admin endpoints (/api/cron/*, /api/ingest, /api/rescore, /api/rewrite).
# Used for manual/admin triggers via `Authorization: Bearer <token>` or `?token=...`.
ADMIN_TOKEN=your-secure-random-token

# Vercel Cron authentication (recommended). When set, Vercel automatically sends
# `Authorization: Bearer <CRON_SECRET>` on scheduled cron invocations, and the
# app stops trusting the spoofable `x-vercel-cron` header on its own. Leave unset
# to fall back to header-based auth (less secure). Generate with `openssl rand -hex 32`.
CRON_SECRET=your-secure-random-cron-secret

# Schema maintenance (optional)
# SEARCH_VECTOR_BACKFILL_BATCH_SIZE=250  # Batch size for schema search_vector backfill
# SEARCH_VECTOR_BACKFILL_ALL=0           # Set to 1 to rebuild all article search vectors in batches
# SCHEMA_ENSURE=0                        # Set to 1 to run per-run DDL guards in ingest/discover. Default OFF — `bun run schema` owns DDL.

# Pipeline health alerting (optional, for app/api/cron/health)
# HEALTH_ALERT_WEBHOOK_URL=https://hooks.example.com/...  # POSTed a JSON payload when the daily health check finds a threshold breach

# Anthropic (required for headline rewriting: Claude Sonnet 5.5, Haiku 5.5
# fallback). Called directly, not through the AI Gateway, so it bills
# Anthropic credits. Set in Vercel as a project env var, not gateway BYOK.
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# OpenAI (optional: direct fallback when a gateway embedding call fails,
# opt-in web search, and OpenAI eval profiles)
OPENAI_API_KEY=sk-your-openai-api-key

# Vercel AI Gateway (embeddings, Jev)
# Local dev: required. Production on Vercel: optional — OIDC is auto-injected
# via VERCEL_OIDC_TOKEN, so the AI SDK falls back to that if this is unset.
AI_GATEWAY_API_KEY=vck-your-ai-gateway-key

# Google News Discovery (optional, for scripts/discover.ts)
# DISCOVER_HL=en-US          # Language code (default: en-US)
# DISCOVER_GL=US             # Country code (default: US)
# DISCOVER_CEID=US:en        # Combined country/language code (default: US:en)
# DISCOVER_QUERIES=climate change,global warming  # Comma-separated search queries
# DISCOVER_RESOLVE_CAP=80    # Max Google News redirect→publisher URL resolutions per run (0 disables)

# Web Discovery (optional, for scripts/discover-web.ts)
# WEB_SEARCH_ENABLED=1                    # Paid OpenAI web-search fallback. Default OFF — free Google News site: + RSS providers carry discovery. Set to 1 to re-enable (~$0.01/call, capped by WEB_SEARCH_MAX_CALLS_PER_RUN).
# WEB_SEARCH_MODEL=gpt-4.1-mini           # Model for web search analysis (default: gpt-4.1-mini)
# WEB_SEARCH_CONTEXT_SIZE=medium          # low/medium/high (default: medium)
# WEB_SEARCH_FORCE_TOOL=1                 # Set to 0 to let the model skip the web-search tool (lowers cost)
# WEB_SEARCH_MAX_CALLS_PER_RUN=25         # Hard ceiling on paid OpenAI web-search calls per run (0 = unlimited)
# WEB_SEARCH_ALLOWED_DOMAINS=example.com  # Comma-separated list of allowed domains
# WEB_SEARCH_DEBUG=0                      # Set to 1 to enable debug logging
# WEB_SEARCH_GN_RESOLVE_CAP=40            # Max Google News redirect resolutions per run
# WEB_SEARCH_FORCE=0                      # Set to 1 to bypass the 4h skip-recent segment guard
# OPENAI_WEB_SEARCH_TOOL_CALL_COST_USD=0.01
# Exa outlet sweep (primary paid discovery tier; runs only in the full cron). Search-only, no contents:
# ~$0.007/call, ~24 calls/day ≈ $5–6/month — inside Exa's $10/month free credit. Budget is a hard cap
# computed from discovery_searches.cost_usd (Exa reports costDollars per call).
# ARTICLE_JUDGE_ENABLED=1                 # Set to 1 to run the judge step in the full/refresh crons (shadow mode:
#                                         # stores model judgments, changes nothing readers see) and to sample
#                                         # keyword-gate rejections. Needs AI_GATEWAY_API_KEY on a paid gateway tier
#                                         # and the tables from `bun run schema`. ~$0.07 per 1,000 articles.
# JUDGE_REJECTION_SAMPLE_RATE=0.2         # Share of keyword-gate rejections kept for judging
# JUDGE_REJECTION_MAX_PER_RUN=40          # Cap on sampled rejections per ingest/discover run
# HEADLINE_CHECK_ENABLED=1                # Set to 1 to fact-check accepted rewritten headlines against their source
#                                         # (shadow mode: recorded in headline_checks, never blocks a headline).
#                                         # Same gateway requirements as the judge step.

# EXA_API_KEY=your-exa-api-key
# WEB_SEARCH_EXA=1                        # Set to 1 to enable the Exa outlet sweep (default: off)
# EXA_MONTHLY_BUDGET_USD=10               # Month-to-date cap; sweep stops when reached (0 = no cap)
# EXA_SEARCH_TYPE=auto                    # auto | fast | instant
# EXA_CATEGORY_NEWS=1                     # Set to 0 to drop Exa's news category filter
# EXA_WINDOW_HOURS=72                     # Look-back per sweep (Exa's index lags ~1–2 days for big outlets)
# EXA_RESULTS_HIGH_VOLUME=12              # Results/call for high-volume outlets (Reuters, Bloomberg, AP…)
# EXA_RESULTS_LOW_VOLUME=10               # Results/call for batched low-volume outlets
# EXA_LOW_VOLUME_BATCH=5                  # Domains per call for low-volume outlets
# EXA_QUERY=...                           # Override the sweep query text

# Node Environment
NODE_ENV=development
